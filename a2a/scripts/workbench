#!/usr/bin/env python3
"""Start or stop the fork desktop with a private application data directory."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import platform
import signal
import subprocess
import sys
import time
from urllib.request import urlopen

import workbench_runtime as runtime


def fail(message):
    print(f"a2a 工作台：{message}", file=sys.stderr)
    raise SystemExit(2)


def build_if_needed(volume):
    cache = volume / "dev-cache/synara/workbench"
    cache.mkdir(parents=True, exist_ok=True)
    with (cache / "build.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        stamp = cache / "build.json"
        files = subprocess.check_output(["git", "ls-files", "-z"], cwd=runtime.REPO).decode().split("\0")
        inputs = [runtime.REPO / name for name in files if name and not name.endswith(".md") and ".test." not in name]
        version = {
            "commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=runtime.REPO, text=True).strip(),
            "inputs": {str(path.relative_to(runtime.REPO)): [path.stat().st_mtime_ns, path.stat().st_size] for path in inputs if path.is_file()},
        }
        outputs = ["apps/desktop/dist-electron/main.js", "apps/desktop/dist-electron/preload.js", "apps/server/dist/index.mjs", "apps/web/dist/index.html"]
        for parent in ("apps", "packages"):
            for package in (runtime.REPO / parent).iterdir():
                for name in ("dist", "dist-electron"):
                    if (package / name).is_symlink():
                        fail(f"构建输出目录是符号链接，拒绝构建：{package / name}")
        if stamp.exists() and json.loads(stamp.read_text(encoding="utf-8")) == version and all((runtime.REPO / name).is_file() for name in outputs):
            return
        print("a2a 工作台：标准 build:desktop 产物缺失或过期，开始构建。", flush=True)
        subprocess.run([str(runtime.REPO / "a2a/scripts/bun"), "run", "build:desktop"], cwd=runtime.REPO, check=True)
        if not all((runtime.REPO / name).is_file() for name in outputs):
            fail("标准构建未产生完整桌面产物。")
        stamp.write_text(json.dumps(version) + "\n", encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(description="fork 桌面工作台；默认数据目录为 ~/Library/Application Support/a2a-workbench")
    parser.add_argument("command", nargs="?", default="start", choices=("start", "stop", "status"))
    args = parser.parse_args()
    data = runtime.data_directory()
    if args.command == "status":
        owner = runtime.read_owner(data)
        print(json.dumps({"data_directory": str(data), "running": owner is not None, "pid": owner["pid"] if owner else None}, ensure_ascii=False))
        return
    volume = Path(os.environ.get("SYNARA_BUILD_VOLUME", "/Volumes/WD-Elements")).resolve()
    if not volume.is_mount() or volume.stat().st_dev == runtime.REPO.stat().st_dev:
        fail(f"外置盘未挂载或与 checkout 同设备：{volume}")
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        fail("仅支持 macOS arm64。")
    if args.command == "stop" and not data.exists():
        print("a2a 工作台：未运行。")
        return
    data.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (data / "workbench.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        owner = runtime.read_owner(data)
        if owner and args.command == "start":
            print(f"a2a 工作台：已在运行（PID {owner['pid']}）。")
            return
        if args.command == "stop":
            if not owner:
                print("a2a 工作台：未运行。")
                return
            os.kill(owner["pid"], signal.SIGUSR2)
            deadline = time.monotonic() + 45
            while runtime.read_owner(data):
                if time.monotonic() >= deadline:
                    fail("优雅停止超时；保留进程和现场供主控检查。")
                time.sleep(0.25)
            print("a2a 工作台：已停止。")
            return
        build_if_needed(volume)
        env = {**os.environ, "A2A_WORKBENCH_DATA_DIR": str(data)}
        with (data / "workbench-launch.log").open("a") as log:
            child = subprocess.Popen(
                [str(runtime.REPO / "a2a/scripts/bun"), "run", "node", str(Path(__file__).with_name("launch-workbench.mjs"))],
                cwd=runtime.REPO, env=env, start_new_session=True,
                stdin=subprocess.DEVNULL, stdout=log, stderr=log,
            )
        deadline = time.monotonic() + 120
        while time.monotonic() < deadline:
            if child.poll() not in (None, 0):
                fail(f"启动失败；查看 {data / 'workbench-launch.log'}")
            if (data / "a2a-gates/endpoint.json").exists():
                published = json.loads((data / "a2a-gates/endpoint.json").read_text(encoding="utf-8"))
                owner = runtime.read_owner(data)
                if not owner or published["desktopPid"] != owner["pid"]:
                    time.sleep(0.25)
                    continue
                endpoint = runtime.read_endpoint(data)
                try:
                    with urlopen(endpoint["origin"] + "/health", timeout=2) as response:
                        ready = response.status == 200
                except OSError:
                    ready = False
                if ready:
                    print(f"a2a 工作台：已启动（PID {endpoint['desktopPid']}）；数据目录 {data}")
                    return
            time.sleep(0.25)
        fail(f"启动尚未就绪；保留现场，查看 {data / 'workbench-launch.log'}，可用 stop 停止。")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        fail(str(error))
