#!/usr/bin/env python3
"""Call the existing gate CLI over the running workbench's HTTP endpoint."""
import json
import os
from pathlib import Path
import subprocess
import sys

import workbench_runtime as runtime

if sys.argv[1:] in (["--help"], ["-h"]):
    print("用法：a2a/scripts/gate status TASK | events TASK | '<门禁请求 JSON>'")
    raise SystemExit(0)
try:
    args = sys.argv[1:]
    if len(args) == 2 and args[0] in ("status", "events"):
        request = json.dumps({"command": args[0], "task": args[1]})
    elif len(args) == 1:
        request = json.dumps(json.loads(args[0]))
    else:
        raise ValueError("用法：a2a/scripts/gate status TASK | events TASK | '<门禁请求 JSON>'")
    endpoint = runtime.read_endpoint(runtime.data_directory())
    env = {**os.environ, "A2A_GATE_BEARER": endpoint["token"]}
    result = subprocess.run([
        str(runtime.REPO / "a2a/scripts/bun"), "run", "packages/a2a-gates/src/cli.ts", endpoint["origin"], request,
    ], cwd=runtime.REPO, env=env)
    raise SystemExit(result.returncode)
except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
    print(f"a2a 门禁：{error}", file=sys.stderr)
    raise SystemExit(2)
